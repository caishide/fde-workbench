  "cards": [
    {
      "dot": "cyan",
      "title": "服务端业务域 (fde_api 单体 · 52 蓝图 · 491 路由)",
      "items": [
        "项目交付: 门禁 G1–G9 · 报价/收款/合同/任务 · 产物采纳与证据候选",
        "售前与交付: 调研 discovery · 方案 plans · 质量 quality · 封包 handover · 转写 transcripts",
        "派单与商业: dispatch(五席位分账+AI推荐) · commercial(多主体科目/席位/商机) · 翻译器 translator",
        "获客与治理: 匿名诊断 diagnostics(默认关404) · 四入口注册 registration · 训练场与学习闭环 simulation"
      ]
    },
    {
      "dot": "emerald",
      "title": "异步任务链与数据底座 (153 表 · 76 迁移)",
      "items": [
        "业务事务内写 outbox_events(必填 subject_org 主体标签), worker 认领后经 Redis fde-jobs 派发",
        "无 Celery: 自研 Redis list 队列 + 租约续期 + 无主作业对账",
        "可重试类型失败自动退避重投(30s 起步 ×2 封顶 900s), outbox 全程保持 dispatched",
        "多租户 orgs 主体归属底座 + 存储五状态机布局(legacy → org/{org_id}/…)"
      ]
    },
    {
      "dot": "amber",
      "title": "Agent 编排 · 沙箱与宿主通道",
      "items": [
        "agents: 跨 run 终审编排 · T1/T2/T6 评审门 · signoff 幂等开闸 · 经验片段 lessons 注入",
        "AI 动作确认闸: api_catalog 98 项 · run_start 必须人工密码确认后落 run(AI 不代发起/重试)",
        "宿主代理 host_agent: 一进程一 run · 15min 短期票据 · ⑦出站白名单闸(HostEgressGate)",
        "容器沙箱 agents/sandbox.py 默认 --network none, compose profile sandbox 默认不启动"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与多客户隔离边界",
      "items": [
        "跨企业可见性单一权威 permissions.py(列表与详情同语义) + is_platform_operator 平台闸",
        "桌面/Web 双桥共用 shared/api-safety.ts 九项安全原语 + 公开诊断面 X-Diagnostic-Token",
        "公网写面纪律: registration/diagnostics 部署闸默认关 404, 诊断配额 fail-closed, 令牌仅存 sha256",
        "真相层零接触: 客户原件只留本地工作目录, 仓库与数据库只存代号 + source_uri + sha256"
      ]
    }
  ]
