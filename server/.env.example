# FDE Workbench 服务端环境变量样例（PostgreSQL 16 口径）。
# 复制为 server/.env 后按现场填值；密钥类一律不入库不入 git。

# —— 运行环境 ——
# 只收 development / test / production（config.py Literal 校验，抄错即 ValidationError）
FDE_ENV=development
# JWT 签名密钥（≥32 字符随机值；必填，无默认）
FDE_JWT_SECRET=replace_with_a_random_value_of_at_least_32_characters
# 桌面端回连 API 的地址
FDE_DESKTOP_API_URL=http://127.0.0.1:8010
FDE_API_HOST=0.0.0.0
FDE_API_PORT=8010
# 产品名单一来源（服务端侧单点；默认=桌面 desktop/src/shared/brand.ts 的 PRODUCT_NAME，改名双侧同步）
# FDE_PRODUCT_NAME=蔡工FDE智能交付系统

# —— 数据库（PostgreSQL 16；容器部署时 host=twenty-db）——
FDE_DATABASE_URL=postgresql+psycopg://fde:CHANGE_ME@127.0.0.1:15432/fde_workbench

# —— Redis（任务队列 / 登录限流 / AI 执行状态）——
FDE_REDIS_URL=redis://127.0.0.1:16379/0

# —— 文件存储（local 开箱即用；oss 需填四项 OSS_*）——
FDE_STORAGE_BACKEND=local
FDE_LOCAL_STORAGE_ROOT=.fde-storage
# FDE_OSS_ENDPOINT=
# FDE_OSS_BUCKET=
# FDE_OSS_ACCESS_KEY_ID=
# FDE_OSS_ACCESS_KEY_SECRET=

# —— AI 供应商（DeepSeek 直连槽位；未配置时相关功能提示未配置而非崩溃）——
# FDE_DEEPSEEK_API_KEY=
FDE_DEEPSEEK_TIMEOUT_SECONDS=90
# E5 降级链备用模型；留空表示不降级
FDE_DEEPSEEK_FALLBACK_MODEL=deepseek-v4
# V3.2 模拟训练场·模型评估层（L-B）的模型槽位（G9 引入，代码默认 deepseek-v4-pro）。
# 注意：**单模型 OpenAI 兼容端点必须显式指定**——留默认 deepseek-v4-pro 在
# MiniMax 等只挂一个模型的端点会被 400 拒（表现为评估行 ai_service_unavailable）。
# 端点只挂一个模型时，按端点实际提供的模型名填（如 MiniMax-M3.1-Flash）。
FDE_DEEPSEEK_SIMULATION_EVALUATION_MODEL=deepseek-v4-pro
# 诊断报告科目评分模型（可选；缺省沿用上面的训练场评估模型槽位。同样遵守
# 上面「单模型端点必须显式指定」教训；键名注意：字段 diagnostic_judge_model
# + env_prefix FDE_ ⇒ 覆写键无 DEEPSEEK 段）
# FDE_DIAGNOSTIC_JUDGE_MODEL=deepseek-v4-pro
# E7 月度 token 预算（按用户；0 = 不限额）
FDE_AI_MONTHLY_TOKEN_BUDGET=0
# V31-P1 推理模型额外特征（Python 正则；留空=只用内置特征识别）。直连腿对
# 命中推理特征的模型把输出预算 ×2（reasoning 与正文共享 max_tokens，不预留
# 时正文被思考挤到截断）。内置已覆盖 MiniMax-M 系列/DeepSeek reasoner·R1/
# QwQ/通用 reasoner·thinking/OpenAI o1·o3·o4；此处为**额外**分支，误配只放宽。
# FDE_AI_REASONING_MODEL_PATTERN=

# —— Kimi/通用 OpenAI 兼容槽位（预调研解析等）——
# FDE_KIMI_PROJECT_PRESURVEY_API_KEY=
FDE_KIMI_PROJECT_PRESURVEY_MODEL=kimi-k3
# 翻译器管道（goal-d14 拍板：**与 AI 聊天同源**——用模型偏好表里配好的那个
# 模型，没配偏好就用系统默认槽位 FDE_DEEPSEEK_*；下列三件是**可选覆盖**，
# 三件配齐才强制走 kimi-k3。多数部署不需要填。）
# FDE_KIMI_TRANSLATOR_API_KEY=
# FDE_KIMI_TRANSLATOR_BASE_URL=https://api.moonshot.cn/v1
# FDE_KIMI_TRANSLATOR_MODEL=kimi-k3
# 供应商不提供 file-extract 时打开：本地解析 DOCX，文件不出本机
FDE_KIMI_LOCAL_DOCX_EXTRACT=false
# 切到 MiniMax 等通用 OpenAI 兼容端点时打开
FDE_KIMI_OPENAI_COMPATIBLE=false

# —— AI Server（DSH 运行时；单机无 DSH 时保持 false，走直连降级）——
FDE_DSH_ENABLED=false
FDE_DSH_BASE_URL=http://127.0.0.1:8020
# FDE_DSH_SERVICE_TOKEN=

# —— 环境样例命名约定：库口令使用 FDE_DB_PASSWORD（compose 引用）——
# FDE_DB_PASSWORD=

# —— WP-E SES 发信（goal-r3 G9 预建；默认关闭，SES 生产批复后按需开启）——
# 开关：不开启时模块整体禁用，回调端点一律 403，零行为影响。
FDE_SES_ENABLED=false
# SES 区域与发信域口径：主域（somwyn.com）不发信，只允许子域。
FDE_SES_REGION=us-east-1
# 允许发信的子域根（如 mail.somwyn.com）与 FROM 地址（须落在该子域内）
# FDE_SES_SEND_SUBDOMAIN=
# FDE_SES_FROM_ADDRESS=
# 可选 Reply-To
# FDE_SES_REPLY_TO_ADDRESS=
# SNS 退信/投诉回调主题 ARN（回调端点的来源白名单）
# FDE_SES_TOPIC_ARN=
# 每日发送上限（沙盒口径默认 10 封/天）
FDE_SES_DAILY_LIMIT=10
# 可选：SES 配置集（退信/投诉事件路由到 SNS 用）
# FDE_SES_CONFIGURATION_SET=

# —— S1 编程工作台（goal-d4）：FDE_AGENT_* 配置族（技术实施方案 §8）——
# 平台月度 agent 预算（token 单位；0 = 不限额，沿 FDE_AI_MONTHLY_TOKEN_BUDGET 心智）
FDE_AGENT_MONTHLY_BUDGET=0
# 单 run 超时（毫秒，D6 默认 300000；agent_registry.max_duration_ms 优先）
FDE_AGENT_MAX_DURATION_MS=300000
# 重试指数退避基长（秒）：第 n 次重试需等待 base*2^(n-1)
FDE_AGENT_RETRY_BACKOFF_BASE_SECONDS=30
# egress allowlist：逗号分隔 IPv4 CIDR（空 = allowlist 档不可用；deny 基线不变）
# FDE_AGENT_ALLOWED_EGRESS=
# 上下文脱敏禁区词（逗号分隔，真实客户名等；命中即拒绝发起 run，fail-closed）
# FDE_AGENT_FORBIDDEN_TERMS=
# run workspace 根目录（相对服务端工作目录）
FDE_AGENT_WORKSPACE_ROOT=agent-workspaces
# —— 宿主侧 zcode 代理通道（V3.1 P1-1 / T-Z1 裁定 A；**默认关**）——
# 容器内 server 进程 spawn 不到宿主桌面进程（zcode 登录态在 Windows 宿主），
# **仅宿主裸跑态**（直跑服务端进程）显式开启后才走本通道；关闭时 run 走既有
# 容器沙箱路径，行为零变化。商用前置：zcode 供应商书面条款未取得前**只作开发自用**。
# 开启且路径缺失 ⇒ 503 + L2 模板填空（零计费，fail-closed，不裸奔半配置）。
# FDE_AGENT_HOST_CHANNEL_ENABLED=0
# ZCode.exe 全路径（Electron 壳；宿主通道 spawn 段）
# FDE_AGENT_HOST_ZCODE_BIN=
# zcode.cjs 全路径（相对安装根 resources/glm/zcode.cjs；宿主通道 spawn 段）
# FDE_AGENT_HOST_ZCODE_CJS=
# 宿主轮询领取通道（P2′① §11.3；**生产启用闸仍关**——与上面的直连通道互斥，
# 同开时轮询形态胜出；开启前须「①实装 + D3 书面回执 + N2 联调签核 +
# ④CR-043 设计轮完成（workflow agent 节点异步消费语义——2026-11-10 蔡工拍板追加，
# 否则开闸后含 agent 节点工作流必 failed 且逐代泄漏计费孤儿 run）」齐备）
# FDE_AGENT_HOST_POLL_ENABLED=0
# 宿主轮询鉴权令牌（明文只放 server/.env 永不入 git；照 FDE_BRIDGE_TOKEN 同纪律）
# FDE_AGENT_HOST_POLL_TOKEN=
# 宿主失联标记最短间隔（分钟；防高频重复落 host_lost 事件）
# FDE_AGENT_HOST_LOST_MARK_MINUTES=

# —— 售前企业名脱敏（T-A2）：现场真实企业名词典指针（可选）——
# 缺省用仓库内种子词典 server/seeds/enterprise-names.txt（只放合成示例）。
# 现场真实词典指向本地文件（执行面不触真相层；真实企业名永不进 git）；
# 指向的文件缺失/不可读 = 机制性故障，fail-closed 硬阻断入库。
# T-A9 转写草稿区（goal-tb tb1）：独立文件根（物理隔离，默认 .fde-transcript-drafts）
# 与 T+7 自动清理保留天数（≥1）。只收文本——录音原件永不进平台（SOP :109/:111）。
# FDE_TRANSCRIPT_DRAFT_ROOT=.fde-transcript-drafts
# FDE_TRANSCRIPT_DRAFT_RETENTION_DAYS=7
# FDE_ENTERPRISE_DICT=

# —— 集成桥 / 登录限流（2026-11-08 补登记，注释态）——
# 集成桥静态令牌：未配置 = 桥整体 503 关闭。真实令牌只放 server/.env，永不提交。
# FDE_BRIDGE_TOKEN=
# 登录限流 fail-closed：设为 1 时 Redis 不可用则拒绝登录；未设 = fail-open 静默放行，不影响认证。
# FDE_LOGIN_RATE_FAIL_CLOSED=1
# 注册面节流 fail-closed：设为 1 时 Redis 不可用则拒绝注册；未设 = fail-open 放行。
# FDE_REGISTRATION_RATE_FAIL_CLOSED=1

# —— 获客诊断工具（T-10a）：匿名免注册诊断面 ——
# 本仓第一个公网免注册写面。**默认关闭**——主部署不暴露匿名写面；D-3 独立轻部署
# 时，诊断面单独 compose / 单独库 / 单独域名，与工作台真相层物理隔离。
# 关闭时诊断路由一律 404（不确认面存在）。
# FDE_DIAGNOSTICS_ENABLED=0
# 限流故障策略：设为 1 时 Redis 不可用即拒绝新请求（默认 fail-closed）；设为 0 则放行。
# 公开写面与登录面相反——匿名面被刷的代价高得多，默认宁可拒绝。
# FDE_DIAGNOSTICS_RATE_FAIL_CLOSED=1
# 每 IP 每日动作上限（创建会话 / 测算 / 答题 / 留资 共用一个计数）。
# FDE_DIAGNOSTICS_DAILY_IP_LIMIT=20
# 每匿名令牌的当日动作配额（访客走完主流程要 5 个动作：测算/续填/留资/报告/分享，
# 留 1 次重试余量）。
# FDE_DIAGNOSTICS_SESSION_QUOTA=6
# AI 报告（T-10b）的**服务账号用户名**：匿名访客没有账号，而 AI 调用入口要求
# 真实用户（预算闸与归因台账都要有主体）⇒ 报告生成记在这个平台账号头上。
# **留空 = 报告功能不可用**（受理时 503 fail-closed，不静默降级）。
# FDE_DIAGNOSTICS_AI_ACTOR_USERNAME=
